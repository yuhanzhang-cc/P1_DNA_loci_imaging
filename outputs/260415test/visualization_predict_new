import numpy as np
import matplotlib.pyplot as plt
import tifffile
from deepblink.io import load_model
from deepblink.inference import predict
from pathlib import Path

# 加载数据
data = np.load('dataset.npz', allow_pickle=True)
x_test = data['x_test']  # 原始图像数组（用于真实点坐标）
y_test = data['y_test']  # 真实点坐标

# 加载模型
model = load_model('deepblink_dna.h5')

# 测试图文件夹
tif_dir = Path('test_images_tif')
out_dir = Path('predictions_overlay')
out_dir.mkdir(exist_ok=True)

for i in range(len(x_test)):
    # 读取原图
    img = tifffile.imread(tif_dir / f'test_image_{i}.tif')
    true_spots = y_test[i]
    
    # 预测
    pred_raw = predict(img, model, probability=0.5)
    pred_spots = pred_raw[:, :2] if len(pred_raw) > 0 else []
    
    # 画图
    plt.figure(figsize=(6, 6))
    plt.imshow(img, cmap='gray')
    
    if len(true_spots) > 0:
        plt.scatter(true_spots[:, 1], true_spots[:, 0], 
                   c='green', s=20, alpha=0.7, label=f'true ({len(true_spots)})')
    if len(pred_spots) > 0:
        plt.scatter(pred_spots[:, 1], pred_spots[:, 0], 
                   c='red', s=20, marker='x', label=f'pred ({len(pred_spots)})')
    
    plt.title(f'Test Image {i}')
    plt.legend()
    plt.axis('off')
    plt.savefig(out_dir / f'test_image_{i}_overlay.png', dpi=150, bbox_inches='tight')
    plt.close()
    print(f"Saved test_image_{i}_overlay.png (true={len(true_spots)}, pred={len(pred_spots)})")

print(f"所有叠加图已保存到 {out_dir}")